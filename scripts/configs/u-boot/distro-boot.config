# LubanCat openEuler —— distro boot 必需的文件系统/分区命令
#
# 为什么需要这个 fragment：Rockchip 的 rk3576_defconfig / lubancat-*_defconfig
# 都没有打开下面这些符号，Kconfig 里它们也没有 default（EFI/DOS_PARTITION 只在
# DISTRO_DEFAULTS=y 时才默认开）。而本项目 boot 分区是 ext2 + boot.scr，
# 走进 config_distro_bootcmd.h 的 BOOTENV 后要用 `test -e` / `load` 读脚本：
# 缺了就是 Unknown command 'load'，内核根本不会被加载。
#
# 厂商的 .config 里这些全是 =y（菜单里手点的、没回写 defconfig），所以他们的
# 预编译 uboot.img 能用；我们照 defconfig 编译就必须显式叠上这一层。
CONFIG_CMD_PART=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_EFI_PARTITION=y
CONFIG_DOS_PARTITION=y

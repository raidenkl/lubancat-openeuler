[Unit]
Description=LubanCat board identification (SARADC) and extboot dtb/uEnv selection
ConditionPathExists=!/boot/.board_init
After=local-fs.target
RequiresMountsFor=/boot
Before=getty.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/lubancat/board-init.sh
TimeoutStartSec=30
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
